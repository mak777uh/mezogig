# Frontend environment (copy to .env)
# Deployed MezoGigEscrow address (set after `npm run deploy:mezo` in the repo root)
VITE_ESCROW_ADDRESS=
# Block the contract was deployed at, so the UI does not scan from genesis
VITE_DEPLOY_BLOCK=0
# WalletConnect Cloud project id (optional; injected wallets work without it)
VITE_WALLETCONNECT_PROJECT_ID=
