# Copy to .env and fill in. NEVER commit .env.
# Private key of a throwaway testnet deployer wallet (testnet BTC only, no real value).
DEPLOYER_PRIVATE_KEY=
# Mezo testnet RPC (default if empty)
MEZO_RPC_URL=https://rpc.test.mezo.org
# MUSD token address on Mezo testnet (default if empty)
MUSD_ADDRESS=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503
# Review period for the demo deployment, in seconds (148 = ~2.5 min)
REVIEW_PERIOD_SECONDS=148
# Optional: explorer API key if the Mezo explorer requires one for verification
MEZO_EXPLORER_API_KEY=
# Frontend: deployed escrow address + WalletConnect project id
VITE_ESCROW_ADDRESS=
VITE_WALLETCONNECT_PROJECT_ID=
